CriarSecaoModo("Estrela", "Estrela", 1, 100, 15)
CriarSecaoModo("Alinhamento", "Alinhamento", -10, 30, 2)
CriarSecaoModo("Furacão", "Furacao", -10, 30, 4)
CriarSecaoModo("Portal", "Portal", -10, 30, 4)
