            if espionandoProps and jogadorSelecionadoProp and jogadorSelecionadoProp.Character then  
                local hum = jogadorSelecionadoProp.Character:FindFirstChildWhichIsA("Humanoid")
                if hum then vuCam.CameraSubject = hum end  
            end  
        else
            jogadorSelecionadoProp = nil
            selecionarTodosProps = false
        end  
    end
})

